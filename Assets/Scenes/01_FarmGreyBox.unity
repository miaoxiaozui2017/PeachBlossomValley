  dialogueLines:
  - "\u540E\u751F\uFF0C\u4F60\u662F\u4ECE\u5C71\u5916\u6765\u7684\u5427\uFF1F"
  - "\u8FD9\u7247\u5730\u8352\u4E86\u4E09\u5E74\uFF0C\u4F60\u82E5\u80AF\u4E0B\u529B\u6C14\uFF0C\u4FBF\u662F\u4F60\u7684\u4E86\u3002"
  - "\u9504\u5730\u3001\u4E0B\u79CD\u3001\u6D47\u6C34\u2026\u2026\u5E84\u7A3C\u8BA4\u4EBA\uFF0C\u65E5\u65E5\u7167\u770B\u624D\u6709\u6536\u6210\u3002"
  - "\u6536\u6210\u653E\u5230\u897F\u8FB9\u90A3\u4E2A\u6728\u7BB1\u91CC\uFF0C\u9694\u5929\u4E00\u65E9\u6362\u4E86\u94B1\u518D\u4E70\u4E9B\u79CD\u5B50\u3002"
  - "\u6709\u5565\u6536\u6210\u820D\u4E0D\u5F97\u5356\u7684\uFF0C\u4E5F\u53EF\u4EE5\u62FF\u6765\u9001\u4EBA\uFF0C\u4E61\u91CC\u4E61\u4EB2\u7684\u3002"
